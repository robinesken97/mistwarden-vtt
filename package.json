{
	"name": "mistwarden-vtt",
	"version": "0.0.0",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"dev:server": "node --env-file-if-exists=.env --watch apps/server/src/index.ts",
		"dev:client": "npm run dev -w @mistwarden/client",
		"start": "node --env-file-if-exists=.env apps/server/src/index.ts",
		"check": "biome check .",
		"format": "biome check --write .",
		"typecheck": "npm run typecheck --workspaces",
		"test": "vitest run",
		"build": "npm run build -w @mistwarden/client",
		"ci": "npm run check && npm run typecheck && npm run test && npm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@types/node": "^24.19.2",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"allowScripts": {
		"better-sqlite3@13.0.3": true,
		"fsevents": false
	}
}
