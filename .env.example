# Mistwarden – Beispielkonfiguration
# Kopieren nach .env und Werte eintragen. Keine echten Werte in diese Datei schreiben.

# Öffentliche Basis-URL, unter der Mistwarden erreichbar ist (immer HTTPS, auch im LAN)
PUBLIC_BASE_URL=https://mistwarden.example.lan

# Adresse und Port, an die der App-Server bindet (hinter dem Reverse Proxy)
HOST=127.0.0.1
PORT=3000

# Pfad zur SQLite-Datenbank
DATABASE_PATH=./data/mistwarden.sqlite

# Ablage für Uploads und erzeugte Größenstufen/Kacheln (z. B. Bind-Mount auf das NAS)
ASSET_STORAGE_PATH=./data/assets

# Maximale Upload-Größe pro Datei in Megabyte
UPLOAD_MAX_MB=200

# Initiales GM-Passwort (wird beim ersten Start gehasht gespeichert; es gibt kein Standardpasswort)
GM_PASSWORD=

# Geheimnis zum Signieren von Sitzungs-Tokens (lange Zufallszeichenkette, z. B. `openssl rand -hex 32`)
SESSION_SECRET=

# Optional, später: Token für Cloudflare Tunnel (Online-Zugang)
TUNNEL_TOKEN=
