# Mistwarden – Beispielkonfiguration
# Kopieren nach .env und Werte eintragen. Keine echten Werte in diese Datei schreiben.

# Öffentliche Basis-URL, unter der Mistwarden erreichbar ist (immer HTTPS, auch im LAN)
PUBLIC_BASE_URL=https://mistwarden.example.lan

# Adresse und Port, an die der App-Server bindet (hinter dem Reverse Proxy)
HOST=127.0.0.1
PORT=3000

# Pfad zur SQLite-Datenbank
DATABASE_PATH=./data/mistwarden.sqlite

# Ablage für Uploads und erzeugte Größenstufen/Kacheln (z. B. Bind-Mount auf das NAS)
ASSET_STORAGE_PATH=./data/assets

# Maximale Upload-Größe pro Datei in Megabyte
UPLOAD_MAX_MB=200

# Größte Raum-Exportdatei beim Import in Megabyte (enthält die Bilder als Base64)
IMPORT_MAX_MB=500

# Gebauter Client (npm run build); leer = apps/client/dist
CLIENT_DIST_PATH=

# GM-Passwort für die ganze Installation (Pflicht, mindestens 10 Zeichen, kein Standardwert).
# Wird beim Start als Argon2-Hash gespeichert. Ändert es sich, werden alle GM-Sitzungen ungültig.
GM_PASSWORD=

# true, wenn ein Reverse Proxy davor sitzt: Die Ratenbegrenzung nutzt dann die Client-IP aus X-Forwarded-For.
# Nur aktivieren, wenn der Server ausschließlich über den Proxy erreichbar ist.
TRUST_PROXY=false

# Optional, später: Token für Cloudflare Tunnel (Online-Zugang)
TUNNEL_TOKEN=
