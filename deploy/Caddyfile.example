# Caddy als Reverse Proxy mit HTTPS im LAN (Kopie nach /etc/caddy/Caddyfile).
# Domain, DNS-Anbieter und Token kommen aus der Umgebung (/etc/caddy/caddy.env), nicht aus dieser Datei.
#
# Variante A (empfohlen): echtes Let's-Encrypt-Zertifikat per DNS-Challenge. Der Name
# (z. B. meinvtt.duckdns.org) zeigt auf die feste LAN-IP des LXC; von außen muss nichts
# erreichbar sein. Braucht ein Caddy mit DNS-Modul des Anbieters (deploy/install.sh lädt es
# mit CADDY_DNS=duckdns bzw. cloudflare). Beide Module nehmen den Token als Argument.
{$MISTWARDEN_DOMAIN} {
	tls {
		dns {$CADDY_DNS} {env.DNS_API_TOKEN}
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}

# Variante B: eigene Zertifizierungsstelle von Caddy (ohne Domain). Dann muss auf jedem
# iPad das Root-Zertifikat installiert und unter Einstellungen → Allgemein → Info →
# Zertifikatsvertrauenseinstellungen aktiviert werden. Statt Variante A verwenden:
#
# {$MISTWARDEN_DOMAIN} {
# 	tls internal
# 	encode zstd gzip
# 	reverse_proxy 127.0.0.1:3000
# }
